DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nihongobridge_dev
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379
CACHE_NAMESPACE=nihongobridge
RATE_LIMIT_FAIL_OPEN=true
SESSION_KEY_PREFIX=tests:session
# Set true in production to reject test operations when Redis is unavailable.
SESSION_REQUIRE_REDIS=false

MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=
MEILISEARCH_DICTIONARY_INDEX=dictionary

# Supabase authentication: configure either the JWT secret or JWKS through SUPABASE_URL.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
# Development-only fallback. Never enable this in production.
ALLOW_INSECURE_USER_HEADER=false

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_AUDIO_BUCKET=audio
MINIO_PUBLIC_READ=true
# Optional comma-separated fallback hosts for trusted non-MinIO audio URLs.
AUDIO_PROXY_ALLOWED_HOSTS=audio.tatoeba.org

EDGE_TTS_FEMALE_VOICE=ja-JP-NanamiNeural
EDGE_TTS_MALE_VOICE=ja-JP-KeitaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%

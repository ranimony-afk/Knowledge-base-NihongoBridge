# PostgreSQL from nihongobridge-knowledge / Phase 1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nihongobridge_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=120000

# Runtime paths
DATA_DIR=./data
REPORT_DIR=./reports
CHECKPOINT_DIR=./.checkpoints

# JMdict source
JMDICT_URL=https://www.edrdg.org/pub/Nihongo/JMdict_e.gz
JMDICT_FILENAME=JMdict_e.xml.gz
# Strongly recommended: set this to a trusted publisher/operator-provided SHA-256.
JMDICT_SHA256=
# Optional URL containing a 64-character SHA-256 digest.
JMDICT_CHECKSUM_URL=
# If true, refuse downloads unless one of the trusted values above is available.
REQUIRE_SOURCE_CHECKSUM=false
VALIDATE_GZIP=true
JMDICT_SOURCE_ATTRIBUTION=jmdict: JMdict/EDRDG (CC BY-SA 3.0)

# Download behavior
HTTP_TIMEOUT_SECONDS=120
HTTP_CONNECT_TIMEOUT_SECONDS=20
DOWNLOAD_RETRIES=4
DOWNLOAD_BACKOFF_SECONDS=1
HTTP_USER_AGENT=NihongoBridge-ETL/1.0

# Pipeline behavior
BATCH_SIZE=750
JMDICT_ESTIMATED_ENTRIES=210000
CHECKPOINT_EVERY_BATCHES=1
VALIDATION_ERROR_SAMPLE_LIMIT=100

# Enrichment sources
# Directory must contain files with N5, N4, N3, N2, N1 in their names.
JLPT_VOCAB_DIR=./data/enrichment/openjlpt
# Supports Innocent Corpus Yomitan ZIP, JSON, CSV, TSV, or text.
INNOCENT_FREQUENCY_PATH=./data/enrichment/innocent_corpus.zip
# auto detects rank/count semantics; override with rank or count when needed.
FREQUENCY_VALUE_MODE=auto
REQUIRE_JLPT_DATA=true
REQUIRE_FREQUENCY_DATA=true

# Tatoeba sentence pipeline
TATOEBA_BASE_URL=https://downloads.tatoeba.org/exports
TATOEBA_SENTENCES_ARCHIVE=sentences.tar.bz2
TATOEBA_LINKS_ARCHIVE=links.tar.bz2
TATOEBA_TAGS_ARCHIVE=tags.tar.bz2
TATOEBA_SENTENCES_SHA256=
TATOEBA_LINKS_SHA256=
TATOEBA_TAGS_SHA256=
TATOEBA_REQUIRE_CHECKSUMS=false
TATOEBA_SOURCE_ATTRIBUTION=tatoeba: Tatoeba (CC BY 2.0 FR)
TATOEBA_STAGE_FILENAME=tatoeba-stage.sqlite3
TATOEBA_BATCH_SIZE=250
TATOEBA_ESTIMATED_JAPANESE_SENTENCES=250000
TATOEBA_SEED_LIMIT_PER_LEVEL=1000
SENTENCE_SEED_DIR=./data/seeds/sentences

# Edge TTS
EDGE_TTS_FEMALE_VOICE=ja-JP-NanamiNeural
EDGE_TTS_MALE_VOICE=ja-JP-KeitaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
TTS_REQUESTS_PER_SECOND=10
TTS_CONCURRENCY=4
TTS_RETRIES=3
TTS_TEMP_DIR=./data/tts-temp

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_AUDIO_BUCKET=audio
# Browser-facing base URL; leave empty to derive it from MINIO_ENDPOINT.
MINIO_PUBLIC_URL=
# Public-read is suitable for pronunciation/listening assets; disable for private buckets.
MINIO_PUBLIC_READ=true

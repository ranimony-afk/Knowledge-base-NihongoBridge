# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_TIMEOUT_MS=45000
AI_PROMPT_VERSION=hana-v1

# PostgreSQL (shared NihongoBridge database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nihongobridge
DATABASE_POOL_MAX=10

# Supabase JWT verification: configure either the HS256 secret or Supabase URL/JWKS
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
ALLOW_INSECURE_USER_HEADER=false

# Redis-backed free-tier rate limit. Falls back to a process-local limiter outside production.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_NAMESPACE=nihongobridge:ai
RATE_LIMIT_FAIL_OPEN=false

# Existing NihongoBridge dictionary API used by Claude tool calls
NIHONGOBRIDGE_API_URL=http://localhost:3000
NIHONGOBRIDGE_API_SERVICE_TOKEN=

# Optional browser endpoint override when TutorChat is hosted separately
NEXT_PUBLIC_AI_API_BASE_URL=

# =============================================================================
# NihongoBridge platform — local development defaults
# Copy to .env. Never commit real production credentials.
# =============================================================================
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nihongobridge_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nihongobridge_test
DATABASE_POOL_MAX=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=120000

# Redis / caching / test sessions
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
CACHE_NAMESPACE=nihongobridge
RATE_LIMIT_NAMESPACE=nihongobridge:ai
RATE_LIMIT_FAIL_OPEN=true
SESSION_KEY_PREFIX=tests:session
SESSION_REQUIRE_REDIS=false

# Meilisearch
MEILISEARCH_PORT=7700
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=local-meilisearch-master-key-change-me
# Search repository uses this equivalent name for administrative setup.
MEILI_MASTER_KEY=local-meilisearch-master-key-change-me
MEILI_ENV=development
MEILISEARCH_DICTIONARY_INDEX=dictionary
SEARCH_BATCH_SIZE=1000
SEARCH_STATE_PATH=./state/last-sync.json
SEARCH_LOCK_PATH=./state/sync.lock
SEARCH_NOTIFY_CHANNEL=nihongobridge_content_changes
AUTOCOMPLETE_HOST=0.0.0.0
AUTOCOMPLETE_PORT=7701
AUTOCOMPLETE_ALLOWED_ORIGINS=http://localhost:3000
AUTOCOMPLETE_CACHE_TTL_MS=300000
AUTOCOMPLETE_CACHE_MAX=2000

# MinIO / S3-compatible object storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_AUDIO_BUCKET=audio
MINIO_IMAGES_BUCKET=images
MINIO_SVGS_BUCKET=svgs
MINIO_PUBLIC_READ=true

# MailHog / local email
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="NihongoBridge <no-reply@nihongobridge.local>"

# Adminer
ADMINER_PORT=8080

# Browser and service URLs
WEB_PORT=3000
API_PORT=3001
ADMIN_PORT=3002
AI_PORT=3003
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:3003
NIHONGOBRIDGE_API_URL=http://localhost:3001
NIHONGOBRIDGE_API_SERVICE_TOKEN=

# Supabase authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
# Development only. Production must always keep this false.
ALLOW_INSECURE_USER_HEADER=false

# Anthropic / Hana-sensei
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_TIMEOUT_MS=45000
AI_PROMPT_VERSION=hana-v1

# Edge TTS
EDGE_TTS_FEMALE_VOICE=ja-JP-NanamiNeural
EDGE_TTS_MALE_VOICE=ja-JP-KeitaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
TTS_REQUESTS_PER_SECOND=10
TTS_CONCURRENCY=4
TTS_RETRIES=3

# ETL sources, paths, and verification
DATA_DIR=./data
REPORT_DIR=./reports
CHECKPOINT_DIR=./.checkpoints
JMDICT_URL=https://www.edrdg.org/pub/Nihongo/JMdict_e.gz
JMDICT_SHA256=
JMDICT_CHECKSUM_URL=
REQUIRE_SOURCE_CHECKSUM=false
VALIDATE_GZIP=true
JMDICT_SOURCE_ATTRIBUTION="jmdict: JMdict/EDRDG (CC BY-SA 3.0)"
JLPT_VOCAB_DIR=./data/enrichment/openjlpt
INNOCENT_FREQUENCY_PATH=./data/enrichment/innocent_corpus.zip
REQUIRE_JLPT_DATA=true
REQUIRE_FREQUENCY_DATA=true
TATOEBA_BASE_URL=https://downloads.tatoeba.org/exports
TATOEBA_SENTENCES_SHA256=
TATOEBA_LINKS_SHA256=
TATOEBA_TAGS_SHA256=
TATOEBA_REQUIRE_CHECKSUMS=false
TATOEBA_SOURCE_ATTRIBUTION="tatoeba: Tatoeba (CC BY 2.0 FR)"
TATOEBA_SEED_LIMIT_PER_LEVEL=1000
QUESTION_LEVEL=N5
QUESTION_SECTION=all
QUESTION_COUNT=20

# Vercel deployment (prefer GitHub secrets in CI)
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
DEPLOY_HEALTH_PATH=/dashboard
DEPLOY_HEALTH_ATTEMPTS=12

# Notifications (prefer GitHub secrets in CI)
SLACK_WEBHOOK_URL=
